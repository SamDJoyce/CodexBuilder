<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="600.0"
      prefWidth="900.0"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="codexbuilder.controller.MainController">

    <TabPane VBox.vgrow="ALWAYS"
             tabClosingPolicy="UNAVAILABLE">
        <tabs>
             	<!-- Wargear Tab -->
	            <Tab text="Wargear">
		            <content>
				        <fx:include 
				        	fx:id="wargearView" 
				        	source="WargearView.fxml" 
				        />
	    			</content>
    			</Tab>
              	<!-- StatLines Tab -->
              	<Tab text="StatLines">
              		<content>
              			<fx:include 
              				fx:id="statLineView" 
              				source="StatLineView.fxml"
      					/>
              		</content>
              	</Tab>
    			<!-- Models Tab -->
	            <Tab text="Models">
	            	<content>
	            	
	            	</content>
	            </Tab>
	            <!-- Units Tab -->
	            <Tab text="Units">
	            	<content>
	            	
	            	</content>
	            </Tab>
	            <!-- Groups Tab -->
	            <Tab text="Option groups">
	            	<content>
	            	
	            	</content>
	            </Tab>
	            <!-- Options Tab -->
	            <Tab text="Options">
	            	<content>
	            	
	            	</content>
	            </Tab>
	            <!-- Requirements Tab -->
	            <Tab text="Requirements">
	            	<content>
	            		<fx:include
	            			fx:id="requirementView"
	            			source="RequirementView.fxml"
	            		/>
	            	</content>
	            </Tab>
	            <!-- Effects Tab -->
	            <Tab text="Effects">
	            	<content>
	            	
	            	</content>
            </Tab>
     	 </tabs>
    </TabPane>
</VBox>
